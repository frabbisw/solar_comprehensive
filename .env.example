# Never commit your real API key.
OPENAI_API_KEY=

# One model/configuration for the revision experiments.
OPENAI_MODEL=gpt-6-luna

# IMPORTANT: keep this as 'none' if RQ1 retains its temperature sweep.
# GPT-6 does not accept temperature when reasoning effort is non-none.
OPENAI_REASONING_EFFORT=none
OPENAI_REASONING_MODE=standard

# Common anchor used by RQ2, RQ3, and RQ4. RQ1 sweeps temperature and includes 0.8.
REVISION_COMMON_TEMPERATURE=0.8
FLOWGEN_TEMPERATURE=0.8

# default = standard online requests. Leave unchanged for smoke tests.
OPENAI_SERVICE_TIER=default
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=3
OPENAI_USAGE_LOG=results/api_usage.jsonl

# FlowGen adaptation for newer models: keep every RQ3 role focused on the
# self-contained benchmark rather than requesting external policy/clarification.
# Applied identically to all 12 RQ3 configurations and does not mention fairness.
FLOWGEN_BENCHMARK_MODE=1
