"""Fairness Repairer for the revised RQ4 FMA pipeline."""
from __future__ import annotations

import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))

from shared.base_agent import BaseAgent
from shared.io_utils import (
    append_jsonl,
    clean_code,
    read_jsonl_list,
    task_code_path,
    task_review_path,
)
from shared.llm_client import chat

SYSTEM_PROMPT = (
    "You are the Fairness Repairer. You will receive a task, a generated method, "
    "and a structured fault report from the Fairness Reviewer. Rewrite the full method "
    "to resolve every reported fault. Remove logic conditioned on restricted attributes "
    "and ensure reported missing required attributes drive the decision as instructed. "
    "Do not add unrelated attributes. Keep the exact method signature and docstring. "
    "Output ONLY the complete method starting from def, with no markdown or explanation."
)


class BiasRepairerAgent(BaseAgent):
    extra_args = [
        (["--code_dir"], {"required": True}),
        (["--review_dir"], {"required": True}),
        (["--output_dir"], {"required": True}),
        (["--num_rounds"], {"type": int, "default": 1}),
    ]

    def process_task(self, task_id: str, prompt: str, args) -> None:
        code_path = task_code_path(args.code_dir, task_id)
        review_path = task_review_path(args.review_dir, task_id)
        out_path = task_code_path(args.output_dir, task_id)
        if not os.path.exists(code_path) or not os.path.exists(review_path):
            print(f"  SKIP task {task_id}: missing inputs")
            return

        os.makedirs(os.path.dirname(out_path), exist_ok=True)
        completed = 0
        if os.path.exists(out_path):
            try:
                completed = len(read_jsonl_list(out_path))
            except Exception:
                completed = 0

        code_rows = read_jsonl_list(code_path)
        review_rows = read_jsonl_list(review_path)
        n = min(args.num_samples, len(code_rows), len(review_rows))
        if completed >= n:
            print(f"Output complete ({completed}/{n}), skipping: {out_path}")
            return

        for i in range(completed, n):
            code_row = code_rows[i]
            code = code_row.get("generated_code", "")
            review = review_rows[i]

            if code_row.get("fma_converged") or review.get("skipped_after_convergence"):
                append_jsonl(
                    out_path,
                    {
                        "generated_code": code,
                        "repaired": False,
                        "rounds": 0,
                        "fma_converged": True,
                    },
                )
                continue

            issues = review.get("issues", [])
            if review.get("pass") and not issues:
                append_jsonl(
                    out_path,
                    {
                        "generated_code": code,
                        "repaired": False,
                        "rounds": 0,
                        "fma_converged": True,
                    },
                )
                continue

            user_msg = (
                f"TASK DESCRIPTION:\n{prompt}\n\n"
                f"GENERATED METHOD:\n{code}\n\n"
                f"FAIRNESS FAULT REPORT:\n{json.dumps(issues, ensure_ascii=False)}"
            )
            raw = chat(
                SYSTEM_PROMPT,
                user_msg,
                model=args.model,
                temperature=args.temperature,
                max_tokens=1024,
            )
            repaired = clean_code(raw)
            append_jsonl(
                out_path,
                {
                    "generated_code": repaired,
                    "repaired": True,
                    "rounds": 1,
                    "fma_converged": False,
                },
            )


if __name__ == "__main__":
    BiasRepairerAgent().run_cli()
